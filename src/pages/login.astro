---
import Layout from "../layouts/layout.astro"
---
<!DOCTYPE html>
<Layout title="Login">
    <div class="grid-cols-1 text-center">
        <div>
            <h3 >User NickName</h3>
            <input type="text" name="NickName">
        </div>
        <div>
            <h3>Email</h3>
            <input type="email" name="Email">
            <h3>PassWord</h3>
        </div>
        <div>
            <input type="password" name="PassWord">
            <h4>Crear usuarrio</h4>
            <button class="btn btn-primary btn-md background-color" type="button">Submit</button>
        </div>
    </div>
</Layout>