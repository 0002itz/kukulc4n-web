---
import Cardproyects from "../components/Cardproyects.astro";
import Cardcolab from "../components/Cardcolab.astro";
import Layout from "../layouts/layout.astro";

import { Colab_db, Proyects_db } from 'astro:db';
import { db } from 'astro:db';
import type { Colab } from "../types";

//pruebas jsno
//import type { Colab, Proyect } from '../types.ts';

//const response = await fetch('../api/data.js');
//const data = await response.json();
//const { colab, proyects } = data.results[0];
//export const colab = await db.select().from(Colab_db).then(JSON.stringify)
export const colab = await db.select().from(Colab_db)
export const proyects = await db.select().from(Proyects_db)
export const Title = "Kukulc4n"
---

<Layout title={ Title }>
	<div class="flex flex-col">
		<div class="p-6">
			<h1 class="text-center">Colaborador:</h1>
			<div>{ colab.map((colabItem ) => ( <Cardcolab imagePath={`/src/assets/${colabItem.colab_name}.png`} colab_obj={colabItem} /> ))} </div>
		</div>
		<div class="p-6">
			<h1 class="text-center">Proyectos:</h1>
			<div> {proyects.map((projectItem) => ( <Cardproyects imagePath={`/src/assets/${projectItem.proyect_name}.png`} proyect_obj={projectItem} /> ))} </div>
		</div>
	</div>
</Layout>
