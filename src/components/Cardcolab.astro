---
import Image from "astro/components/Image.astro";

interface Props {
    imagePath: string;
    colab_obj:{
        colab_name: string;
        tecnolig: string;
        proyect_list: string;
        desafios: string;
        corro: string;
    }
}

const { colab_obj,imagePath} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}')

if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`);
---

<div class="w-full md:flex sm:grid-cols-1 p-4 items-center bg-purple-950 rounded-lg border shadow-md container">
    <picture class="flex place-content-center rounded-full">
        <Image class="rounded-lg" loading="eager" src={images[imagePath]()} alt="Descripción de la imagen" width={200} height={200}/>
    </picture>
    <div>
        <h2 class="p-2 my-2 text-2xl font-blod tracking-tight text-white">
            Nickname:
        </h2>
        <p class="md-4 font-Light text-gray-400">
            { colab_obj.colab_name }
        </p>
        <h4 class="p-2 my-2 text-2xl font-blod tracking-tight text-white">
            Tecnologias:
        </h4>
        <p class="md-4 font-Light text-gray-400">
            { colab_obj.tecnolig }
        </p>

        <h4 class="p-2 my-2 text-2xl font-blod tracking-tight text-white">
            Desafios:
        </h4>
        <p class="md-4 font-Light text-gray-400">
            { colab_obj.desafios}
        </p>
    </div>
</div>